# Tennis Coach App - Frontend Config
# Just set VITE_PROFILE and API URL!

# Local development
VITE_PROFILE=local
# Relative, so API calls stay same-origin and go through the vite proxy in
# vite.config.ts. An absolute http://localhost:8000 URL breaks whenever the app
# is opened on any origin other than localhost -- an OrbStack *.orb.local
# domain, a tunnel, or another device -- because the browser then blocks it as
# cross-origin or mixed content. Only set an absolute URL when the API really
# is on another host (see the production block below).
VITE_API_URL=/v0

# Production (uncomment and fill in)
# VITE_PROFILE=production
# VITE_API_URL=https://your-api.com/v0
# VITE_SUPABASE_URL=https://...
# VITE_SUPABASE_PUBLISHABLE_KEY=...
